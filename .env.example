# Copy this file to .env and fill in the values you need.
# ThreatLens AI works with no keys configured (local behavioural detection only),
# but these enable optional threat-intel enrichment.

# OpenAI API key — enables AI-generated attack narratives and GPT-powered analysis.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# VirusTotal API key — enables the "Use VirusTotal API" toggle in the sidebar.
# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB API key — enables IP reputation lookups.
# https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# Optional: path to a live log file for real-time monitoring mode.
# LIVE_LOG_PATH=/var/log/auth.log
